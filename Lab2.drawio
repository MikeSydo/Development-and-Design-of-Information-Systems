          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Готовий код" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="development" target="test">
          <mxGeometry relative="1" as="geometry"/>
