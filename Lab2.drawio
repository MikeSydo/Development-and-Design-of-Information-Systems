<mxfile host="app.diagrams.net">
  <diagram id="dfd-context" name="DFD - Контекст">
    <mxGraphModel>
      <root>

        <!-- Зовнішня сутність -->
        <mxCell
          id="e1"
          value="Ініціатор / дослідник"
          style="shape=rectangle;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="1">
          <mxGeometry x="55" y="200"
                      width="180" height="75"
                      as="geometry"/>
        </mxCell>

        <!-- Процес -->
        <mxCell
          id="p0"
          value="0&#xa;Управління життєвим циклом даних дослідницького проєкту"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1"
          parent="1">
          <mxGeometry x="405" y="250"
                      width="360" height="170"
                      as="geometry"/>
        </mxCell>

        <!-- Потік даних -->
        <mxCell
          id="f1"
          value="Проєктна пропозиція / вимоги"
          style="edgeStyle=orthogonalEdgeStyle;
                 html=1;endArrow=block;"
          edge="1"
          parent="1"
          source="e1"
          target="p0">
          <mxGeometry relative="1"
                       as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
