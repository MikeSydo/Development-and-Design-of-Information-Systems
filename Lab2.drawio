        <mxCell id="F2" value="Метадані існуючих робіт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="P2">
          <mxGeometry relative="1" as="geometry">
            <Array points="350,180;140,180" />
          </mxGeometry>
        </mxCell>

        <!-- Re-Use з архіву в Discovery -->
        <mxCell id="F3" value="Re-Use: заархівовані дані" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="DS1" target="P1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ініціація та старт -->
        <mxCell id="F4" value="Ініціація та вимоги" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="EE2" target="P2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="F5" value="Затверджений план проекту" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P2" target="P3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="F6" value="Регламент та ресурси" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P3" target="P4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Збір -> Аналіз -> Поширення -->
        <mxCell id="F7" value="Сирі дані (Raw data)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P4" target="P5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="F8" value="Оброблений масив (Processed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P5" target="P6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Re-Purpose цикл зворотного зв'язку -->
        <mxCell id="F9" value="Re-Purpose: повторне використання" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="P6" target="P4">
          <mxGeometry relative="1" as="geometry">
            <Array points="880,480;520,480" />
          </mxGeometry>
        </mxCell>

        <!-- Поширення користувачам -->
        <mxCell id="F10" value="Публікації, звіти, API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P6" target="EE3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Завершення проекту -->
