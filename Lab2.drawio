        </mxCell>
        <mxCell id="pending" value="&lt;b&gt;1. Очікування&lt;/b&gt;&lt;br&gt;Pending&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;WIP = 6&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="245" width="170" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;2. Аналіз вимог&lt;/b&gt;&lt;br&gt;Analysis&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;WIP = 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="245" width="170" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="development" value="&lt;b&gt;3. Розроблення&lt;/b&gt;&lt;br&gt;Development&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;WIP = 5&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="245" width="170" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="test" value="&lt;b&gt;4. Тестування&lt;/b&gt;&lt;br&gt;Test&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;WIP = 3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="245" width="170" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;5. Розгортання&lt;/b&gt;&lt;br&gt;Deploy&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;WIP = 5&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1180" y="245" width="170" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="Розгорнута&lt;br&gt;функціональність" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1410" y="280" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="Нове завдання" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="input" target="pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Завдання для аналізу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending" target="analysis">
